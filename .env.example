# Site configuration
VITE_SITE_TITLE=گل‌های روسی انعطاف‌پذیر
VITE_CONTACT_EMAIL=info@example.com
# Contact channels — Telegram, WhatsApp, and Bale (بله). No phone channel.
# Leave any blank to hide that channel (an unset value never renders a fake link).
VITE_TELEGRAM_URL=
# International digits, no + or 00 (e.g. 989121234567).
VITE_WHATSAPP_NUMBER=
# Bale (Iranian messenger) profile deep-link, e.g. https://ble.ir/username
VITE_BALE_URL=

# Enamad e-trust seal (Iran). The real nilagol.ir seal is baked into
# src/data/config.js as the default, so these are OPTIONAL overrides. If you do
# override, keep VITE_ENAMAD_CODE in sync with the Code in the URLs — Enamad's
# domain verification scans the page for the `code` attribute on the seal image.
VITE_ENAMAD_IMG=
VITE_ENAMAD_LINK=
VITE_ENAMAD_CODE=

# Supabase — from your project's Connect / API settings.
# Preferred for local Vite development:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy local alias still supported by the app if your project uses an anon key:
# VITE_SUPABASE_ANON_KEY=eyJ...

# On Vercel, the official Supabase integration can inject SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY automatically; vite.config.js safely bridges those
# public values into the Vite client bundle. Never expose SUPABASE_SECRET_KEY.
